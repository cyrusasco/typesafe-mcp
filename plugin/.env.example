# typesafe-mcp environment — copy to .env (see lookup order below) and fill in,
# or set as real env vars instead.
#
# .env lookup order: $TYPESAFE_DATA_DIR/.env → <plugin dir>/.env (this file's
# dir). In a repo/marketplace checkout the data dir is the repo root (it holds
# executors.json), so root/.env wins; in a self-contained plugin-cache install
# the plugin dir itself is the data dir. process.env always beats any .env.

# TypeSafe System One API key. REQUIRED for normal mode; without it ts_ask
# returns {mode:"degraded", reason:"no_key"} and never calls the API.
TYPESAFE_API_KEY=

# Model slug (default jev-latest).
TYPESAFE_MODEL=jev-latest

# Daily token budget (input+output summed from today's ledger). When today's
# total reaches the cap, ts_ask degrades with budget_capped. Default 200000.
TYPESAFE_DAILY_TOKEN_CAP=200000

# Per-request timeout in ms (covers the response body read too). Default 5000.
TYPESAFE_TIMEOUT_MS=5000

# Retries on HTTP 429/529 with exponential backoff (500ms * 2^n). Default 2.
TYPESAFE_MAX_RETRIES=2

# Optional: pin the data dir (ledger/, .env, executors.json, patterns.json) to
# a stable location that survives plugin-cache refreshes. Defaults: parent dir
# if it contains executors.json, else the plugin dir.
# TYPESAFE_DATA_DIR=

# Optional: keys for OTHER executors (DEEPSEEK_API_KEY, QWEN_API_KEY, ...) may
# also live here — ts_feasible counts process.env AND this file when checking
# executors.json requires.env.
